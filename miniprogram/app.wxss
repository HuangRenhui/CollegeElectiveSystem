/**
 * 全局样式：对齐 Web 端 Element Plus 的视觉规范。
 *
 * 小程序 WXSS 支持 CSS 变量，统一在 page 上定义，各页面直接引用。
 */
page {
  --primary: #409eff;
  --success: #67c23a;
  --warning: #e6a23c;
  --danger: #f56c6c;
  --info: #909399;

  --text-main: #303133;
  --text-regular: #606266;
  --text-secondary: #909399;
  --text-placeholder: #c0c4cc;

  --border: #ebeef5;
  --border-light: #f0f0f0;
  --bg-page: #f5f7fa;
  --bg-card: #ffffff;

  background-color: var(--bg-page);
  color: var(--text-main);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  line-height: 1.6;
}

/* ---------------------------- 布局容器 ---------------------------- */
.page-container {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* ---------------------------- 文本工具类 ---------------------------- */
.text-muted {
  color: var(--text-secondary);
  font-size: 24rpx;
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-center {
  text-align: center;
}

/* ---------------------------- 通用标签 ---------------------------- */
.tag {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  line-height: 1.6;
}

.tag--primary { color: var(--primary); background: rgba(64, 158, 255, 0.12); }
.tag--success { color: var(--success); background: rgba(103, 194, 58, 0.12); }
.tag--warning { color: var(--warning); background: rgba(230, 162, 60, 0.12); }
.tag--danger  { color: var(--danger);  background: rgba(245, 108, 108, 0.12); }
.tag--info    { color: var(--info);    background: rgba(144, 147, 153, 0.12); }

/* ---------------------------- 空状态 ---------------------------- */
.empty {
  padding: 120rpx 0;
  text-align: center;
  color: var(--text-placeholder);
}

.empty__icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

/* ---------------------------- 按钮 ---------------------------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 1;
}

.btn--primary {
  background: var(--primary);
  color: #fff;
}

.btn--primary--plain {
  background: rgba(64, 158, 255, 0.1);
  color: var(--primary);
}

.btn--danger--plain {
  background: rgba(245, 108, 108, 0.1);
  color: var(--danger);
}

.btn--disabled {
  background: #f0f2f5 !important;
  color: var(--text-placeholder) !important;
}
