/* ---------------------------- 概览 ---------------------------- */
.overview__title {
  font-size: 34rpx;
  font-weight: 600;
}

.overview__desc {
  margin-top: 8rpx;
  font-size: 26rpx;
}

.overview__actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 24rpx;
}

.action {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-regular);
  background: #f2f3f5;
}

.action--primary {
  color: var(--primary);
  background: rgba(64, 158, 255, 0.12);
}

/* ---------------------------- 公告条目 ---------------------------- */
.item__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.item__title {
  flex: 1;
  margin-right: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
}

/* 未读红点 */
.item__dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: var(--danger);
  vertical-align: middle;
}

.item__tags {
  display: flex;
  flex-shrink: 0;
  gap: 8rpx;
}

.item__meta {
  margin-top: 10rpx;
  font-size: 24rpx;
}

.dot {
  margin: 0 10rpx;
}

.item__content {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-light);
  font-size: 27rpx;
  line-height: 1.8;
  color: var(--text-regular);
  word-break: break-all;
  white-space: pre-wrap;
}

.item__more {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--primary);
}

/* ---------------------------- 空状态 ---------------------------- */
.empty__icon {
  font-size: 72rpx;
}
