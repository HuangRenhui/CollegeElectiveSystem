.profile {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #409eff 0%, #66b1ff 100%);
  color: #fff;
}

.profile__avatar {
  width: 108rpx;
  height: 108rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 108rpx;
  text-align: center;
}

.profile__info {
  flex: 1;
}

.profile__name {
  font-size: 36rpx;
  font-weight: 700;
}

.profile__sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

/* ---------------------------- 菜单 ---------------------------- */
.menu {
  padding: 0 28rpx;
}

.menu__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
  border-bottom: 1rpx solid var(--border-light);
  font-size: 29rpx;
}

.menu__item:last-child {
  border-bottom: none;
}

.menu__arrow {
  font-size: 36rpx;
  color: var(--text-placeholder);
}

/* ---------------------------- 说明 ---------------------------- */
.tip__title {
  font-size: 27rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.tip__text {
  font-size: 25rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

.logout {
  margin-top: 40rpx;
}
