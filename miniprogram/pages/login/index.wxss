.login {
  min-height: 100vh;
  padding: 120rpx 56rpx 0;
  box-sizing: border-box;
  background: linear-gradient(180deg, #409eff 0%, #f5f7fa 42%);
}

.login__header {
  text-align: center;
  color: #fff;
  margin-bottom: 72rpx;
}

.login__logo {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto 28rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
  font-size: 60rpx;
  font-weight: 700;
  line-height: 128rpx;
  text-align: center;
}

.login__title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.login__subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

.login__form {
  background: #fff;
  border-radius: 20rpx;
  padding: 48rpx 40rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.field {
  margin-bottom: 36rpx;
}

.field__label {
  font-size: 26rpx;
  color: var(--text-regular);
  margin-bottom: 14rpx;
}

.field__input {
  height: 88rpx;
  padding: 0 24rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.field__placeholder {
  color: var(--text-placeholder);
}

.login__submit {
  margin-top: 48rpx;
}

.login__demo {
  margin-top: 40rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid var(--border-light);
}

.login__demo-title {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 18rpx;
}

.login__demo-list {
  display: flex;
  gap: 20rpx;
}

.login__demo-item {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--primary);
  background: rgba(64, 158, 255, 0.1);
  border-radius: 10rpx;
}
